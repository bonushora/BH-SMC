module.exports = {

    interpretarMensagem: function(payload) {

        const mensagem =
            payload.mensagem
                .toLowerCase()
                .trim();


        if (
            mensagem === "saldo" ||
            mensagem === "ver saldo"
        ) {

            return {

                comando:
                    "CONSULTAR_SALDO",

                numero:
                    payload.identificador

            };

        }


        return {

            comando:
                "MENU_PRINCIPAL",

            numero:
                payload.identificador

        };

    }

};

